<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CountdownProject.Pages.GamePage"
             Title="Countdown Game">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label x:Name="TimerLabel"
               Text="00:30"
               FontSize="28"
               HorizontalOptions="Center" />

        <HorizontalStackLayout x:Name="LettersLayout"
                               Spacing="5"
                               HorizontalOptions="Center" />

        <Entry x:Name="Player1Input"
               Placeholder="Player 1 word" />
        <Entry x:Name="Player2Input"
               Placeholder="Player 2 word" />

        <Label x:Name="Player1Score"
               Text="Player 1 Score: 0" />
        <Label x:Name="Player2Score"
               Text="Player 2 Score: 0" />

        <Button Text="Start Round" Clicked="OnStartClicked" />
        <Button Text="Submit Words" Clicked="OnSubmitClicked" />

    </VerticalStackLayout>
</ContentPage>
