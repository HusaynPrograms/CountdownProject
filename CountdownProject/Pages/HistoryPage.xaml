<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CountdownProject.Pages.HistoryPage"
             Title="History">

    <VerticalStackLayout Padding="12" Spacing="8">

        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
            <Button Text="Refresh" Clicked="RefreshList" />
            <Button Text="Clear All" Clicked="ClearAll" />
        </HorizontalStackLayout>

        <CollectionView x:Name="List"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="4" HasShadow="False" BorderColor="#ddd">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding When, StringFormat='{}{0:dd MMM yyyy HH:mm}'}" FontAttributes="Bold" />
                            <Label Text="{Binding Letters, StringFormat='Letters: {0}'}" />
                            <Label Text="{Binding Player1, StringFormat='P1: {0}'}" />
                            <Label Text="{Binding Player2, StringFormat='P2: {0}'}" />
                            <Label Text="{Binding Word1, StringFormat='Word1: {0}'}" />
                            <Label Text="{Binding Word2, StringFormat='Word2: {0}'}" />
                            <Label Text="{Binding RoundScore1, StringFormat='Round: P1 {0}'}" />
                            <Label Text="{Binding RoundScore2, StringFormat='Round: P2 {0}'}" />
                            <Label Text="{Binding Total1, StringFormat='Total: P1 {0}'}" />
                            <Label Text="{Binding Total2, StringFormat='Total: P2 {0}'}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
