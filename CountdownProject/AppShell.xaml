<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:CountdownProject.Pages"
    x:Class="CountdownProject.AppShell">

    <TabBar>
        <ShellContent Title="Home" ContentTemplate="{DataTemplate pages:HomePage}" />
        <ShellContent Title="Game" ContentTemplate="{DataTemplate pages:GamePage}" />
        <ShellContent Title="History" ContentTemplate="{DataTemplate pages:HistoryPage}" />
        <ShellContent Title="Settings" ContentTemplate="{DataTemplate pages:SettingsPage}" />
    </TabBar>

</Shell>
